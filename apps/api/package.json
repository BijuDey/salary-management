{
  "name": "@salary/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/seed.ts",
    "start:prod": "node dist/seed/seed.js --if-empty && node dist/server.js",
    "lint": "eslint .",
    "auth:hash-password": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^10.3.0",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
