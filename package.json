{
  "name": "salary-management",
  "private": true,
  "description": "Employee salary management for ACME's HR team",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "db:seed": "pnpm --filter @salary/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
